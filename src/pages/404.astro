---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Red Thread NPC"
  description="The page you're looking for doesn't exist. Explore Red Thread's coaching, craftivism, and water governance practices instead."
  noindex={true}
>
  <section class="pt-24 pb-28 px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto text-center space-y-6">
    <span class="text-xs font-semibold uppercase tracking-widest text-terracotta">404 &bull; Not Found</span>
    <h1 class="text-4xl sm:text-6xl font-display-light text-ink tracking-tight">
      This thread <span class="font-display-italic text-thread-red">doesn't lead anywhere</span>.
    </h1>
    <p class="text-base sm:text-lg text-ink-muted font-light leading-relaxed max-w-xl mx-auto">
      The page you're looking for may have moved or no longer exists. Here are a few places to pick the thread back up.
    </p>
    <div class="pt-4 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
      <a
        href="/"
        class="editorial-btn px-7 py-3.5 bg-ink hover:bg-thread-crimson text-white text-xs uppercase tracking-widest font-semibold"
      >
        Back to Home
      </a>
      <a
        href="/services"
        class="editorial-btn px-7 py-3.5 bg-canvas-pure border border-quiet-gray/30 hover:bg-paper-gray text-ink text-xs uppercase tracking-widest font-semibold"
      >
        Explore Practices
      </a>
      <a
        href="/contact"
        class="editorial-btn px-7 py-3.5 bg-canvas-pure border border-quiet-gray/30 hover:bg-paper-gray text-ink text-xs uppercase tracking-widest font-semibold"
      >
        Contact Us
      </a>
    </div>
  </section>
</BaseLayout>
