---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://redthread-zeta.vercel.app';
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Barbara Schreiner",
  "jobTitle": "Founder & Executive Director, Red Thread NPC",
  "description": "Writer, transformational coach, textile artist, and senior water governance advisor with over 30 years of public policy leadership in South Africa and internationally.",
  "image": `${siteUrl}/images/conference-bali-panel.webp`,
  "url": new URL(Astro.url.pathname, siteUrl).toString(),
  "worksFor": {
    "@type": "NGO",
    "name": "Red Thread NPC",
    "url": siteUrl
  },
  "knowsAbout": [
    "Transformational Leadership Coaching",
    "Water Governance & Integrity",
    "Chilean Arpillera & Textile Craftivism",
    "Public Sector Policy Frameworks",
    "Creative Writing & Collective Healing"
  ]
};
---

<BaseLayout
  title="About Barbara Schreiner & Red Thread NPC"
  description="Bringing 30+ years of senior water governance, published literature, Chilean arpillera craftivism, and transformational leadership coaching to the table."
  jsonLd={personSchema}
>
  <!-- Hero Section -->
  <section class="pt-16 pb-20 md:pt-24 md:pb-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="max-w-4xl space-y-6">
      <span class="reveal text-xs font-semibold uppercase tracking-widest text-terracotta">About the Founder</span>
      <h1 class="reveal delay-100 text-4xl sm:text-6xl md:text-7xl font-display-light text-ink tracking-tight">
        Bringing a long career to the <span class="font-display-italic text-thread-red">table</span>.
      </h1>
      <p class="reveal delay-200 text-lg sm:text-xl text-ink-muted font-light leading-relaxed">
        Moving between worlds that aren’t supposed to overlap: government offices and theatre back rooms, water governance and writing workshops, senior management and needle and thread.
      </p>
    </div>
  </section>

  <!-- Narrative & Portrait Section -->
  <section class="pb-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Portrait & Quick Facts -->
      <div class="reveal lg:col-span-5 space-y-8 lg:sticky lg:top-28">
        <div class="space-y-4">
          <figure class="group relative w-full overflow-hidden bg-paper-gray border border-quiet-gray/20">
            <img
              src="/images/conference-bali-panel.webp"
              width="1800"
              height="1350"
              alt="Barbara Schreiner speaking on a panel at the 10th World Water Forum, Bali 2024"
              fetchpriority="high"
              decoding="async"
              class="w-full h-auto object-cover hover-img-zoom group-hover:scale-[1.03] transition-transform duration-700"
            />
            <figcaption class="absolute bottom-0 inset-x-0 bg-ink/90 backdrop-blur-sm px-4 py-2.5 text-white text-[10px] uppercase tracking-wider font-semibold flex items-center justify-between">
              <span>Barbara Schreiner</span>
              <span class="font-mono text-white/60">10th World Water Forum, Bali 2024</span>
            </figcaption>
          </figure>
          <div class="p-4 bg-paper-gray/40 border border-quiet-gray/20 text-xs text-ink-muted space-y-1">
            <div class="font-serif font-bold text-ink text-sm">Barbara Schreiner</div>
            <div class="text-[11px] text-terracotta font-medium uppercase tracking-wider">Founder & Executive Director</div>
            <div class="text-[11px] text-ink-muted/80">Author · Transformational Coach · Water Governance Expert · Arpillera Artist</div>
            <a
              href="https://www.linkedin.com/in/barbara-schreiner-23a8b512/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-[#0A66C2] hover:text-[#004182] font-semibold pt-1"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
              <span>Connect on LinkedIn</span>
            </a>
          </div>
        </div>

        <div class="p-6 bg-paper-gray/50 border border-quiet-gray/20 space-y-4">
          <h3 class="font-serif text-lg text-ink font-semibold">At a Glance</h3>
          <ul class="space-y-3 text-xs text-ink-muted">
            <li class="flex items-start gap-2">
              <span class="text-thread-red font-bold">›</span>
              <span><strong>Current Role:</strong> Founder of Red Thread NPC & Executive Director of the Water Integrity Network (WIN).</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-thread-red font-bold">›</span>
              <span><strong>Leadership & Boards:</strong> 30+ years across government, consulting, and international water governance boards — <a href="#leadership" class="text-thread-red hover:underline">see full record below</a>.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-thread-red font-bold">›</span>
              <span><strong>Cultural Activism:</strong> Writer, poet, novel author, and arpillera textile artist.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-thread-red font-bold">›</span>
              <span><strong>Education:</strong> MPhil in Environmental Science (Distinction, UCT), MA (Lancaster, UK), BA Hons (Natal).</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-thread-red font-bold">›</span>
              <span><strong>Governance:</strong> Red Thread NPC is guided by two additional directors — <a href="#directors" class="text-thread-red hover:underline">see our Directors below</a>.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Extended Personal Copy from Original Site + CV -->
      <div class="lg:col-span-7 space-y-8 text-base text-ink-muted font-light leading-relaxed">
        <div class="space-y-6">
          <p class="text-lg text-ink font-normal leading-relaxed">
            I’ve spent most of my working life moving between worlds that aren’t supposed to overlap: government offices and theatre back rooms, water governance and writing workshops, senior management and needle and thread.
          </p>

          <p>
            For over thirty years I’ve worked in water &mdash; as <strong>Advisor to three Ministers of Water Affairs and Forestry</strong> in South Africa, as <strong>Deputy Director General at South Africa’s Department of Water Affairs</strong>, and in independent consulting as Senior Consultant and Practice Director at Pegasys Strategy and Development and later Executive Director of the Pegasys Institute, advising governments, utilities, and development partners across Africa on water governance, institutional reform, and policy design. More recently I've served as <strong>Executive Director of the Water Integrity Network (WIN)</strong>, an international NGO working globally on water and sanitation governance, anti-corruption, and integrity.
          </p>

          <p>
            I’ve published widely on water policy, governance, legislation and practice with a focus on equity, gender transformation and poverty eradication. In the process I have gained deep experience on enabling people and organisations to work better across South Africa, Germany, and global institutions.
          </p>

          <div class="py-4 my-4 border-y border-quiet-gray/20 italic font-serif text-ink text-lg leading-relaxed">
            &ldquo;Before any of that, and running alongside it, I have been a writer and a cultural activist.&rdquo;
          </div>

          <p>
            I edited a collection of women’s prison writings, ran creative writing workshops across South Africa for the Congress of South African Writers (COSAW), led a national writers’ magazine’s editorial collective for six years, and published two novels, a biography, and poetry along the way.
          </p>

          <p>
            My textile art draws on the <strong>arpillera tradition</strong> &mdash; using cloth and thread to tell stories of injustice, discrimination, trauma, and resistance. Objects become arguments and evidence, inviting viewers to confront what official narratives leave unaddressed.
          </p>

          <figure class="group relative w-full max-w-sm overflow-hidden bg-paper-gray border border-quiet-gray/20 my-6">
            <img
              src="/images/portrait-forest.webp"
              width="1125"
              height="1500"
              loading="lazy"
              decoding="async"
              alt="Barbara Schreiner outdoors"
              class="w-full h-auto object-cover hover-img-zoom group-hover:scale-[1.03] transition-transform duration-700"
            />
          </figure>

          <p>
            More recently, I trained as a coach and counsellor, because thirty years of watching capable people burn out or lose their way convinced me that leadership and institutions are only ever as good as the people inside them, and those people need somewhere to reflect and grow.
          </p>
        </div>

        <!-- Personal Signoff from Original Site -->
        <div class="pt-6 border-t border-quiet-gray/20">
          <p class="font-serif text-xl text-ink italic mb-1">
            I look forward to engaging with you,
          </p>
          <span class="font-serif text-2xl font-bold text-thread-crimson tracking-tight">
            Barbara
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission, Vision, and Values Section (Original Site) -->
  <section id="values" class="py-24 bg-canvas-pure border-y border-quiet-gray/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="reveal text-center max-w-3xl mx-auto mb-16 space-y-4">
        <span class="text-xs font-semibold uppercase tracking-widest text-terracotta">Our Guiding Compass</span>
        <h2 class="text-4xl sm:text-5xl font-display-light text-ink">
          Mission, Vision & <span class="font-display-italic text-thread-red">Values</span>.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Mission -->
        <div class="reveal delay-100 p-8 bg-canvas border border-quiet-gray/20 flex flex-col justify-between">
          <div>
            <span class="text-[11px] font-semibold uppercase tracking-widest text-terracotta block mb-3">Our Mission</span>
            <h3 class="font-serif text-2xl text-ink font-semibold mb-4">Agency & Expression</h3>
            <p class="text-sm text-ink-muted leading-relaxed font-light">
              &ldquo;To turn testimony into transformation using creative, people-centred methods that enable individuals, communities, and public institutions to find their voice, confront systemic obstacles, and build sustainable pathways for change.&rdquo;
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-quiet-gray/15 text-xs text-thread-red font-medium">
            Voice, Testimony & Renewal
          </div>
        </div>

        <!-- Vision -->
        <div class="reveal delay-200 p-8 bg-canvas border border-quiet-gray/20 flex flex-col justify-between">
          <div>
            <span class="text-[11px] font-semibold uppercase tracking-widest text-terracotta block mb-3">Our Vision</span>
            <h3 class="font-serif text-2xl text-ink font-semibold mb-4">Equity & Integrity</h3>
            <p class="text-sm text-ink-muted leading-relaxed font-light">
              &ldquo;A society grounded in human dignity and justice, where untold stories find fearless expression, vital resources are safeguarded with unyielding integrity, and creative dialogue inspires lasting social change.&rdquo;
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-quiet-gray/15 text-xs text-thread-red font-medium">
            Dignity, Justice & Governance
          </div>
        </div>

        <!-- Values -->
        <div class="reveal delay-300 p-8 bg-canvas border border-quiet-gray/20 flex flex-col justify-between">
          <div>
            <span class="text-[11px] font-semibold uppercase tracking-widest text-terracotta block mb-3">Core Values</span>
            <h3 class="font-serif text-2xl text-ink font-semibold mb-4">The Ethical Foundation</h3>
            <ul class="space-y-3 text-sm text-ink-muted font-light">
              <li class="flex items-center gap-2.5">
                <span class="w-1.5 h-1.5 bg-thread-red shrink-0"></span>
                <strong class="text-ink font-medium">Deep listening without preconceptions</strong>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="w-1.5 h-1.5 bg-thread-red shrink-0"></span>
                <strong class="text-ink font-medium">Respect for lived experience</strong>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="w-1.5 h-1.5 bg-thread-red shrink-0"></span>
                <strong class="text-ink font-medium">Intellectual & institutional honesty</strong>
              </li>
            </ul>
          </div>
          <div class="mt-8 pt-4 border-t border-quiet-gray/15 text-xs text-thread-red font-medium">
            Grounded in Integrity
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Professional CV & Career Timeline Integration -->
  <section id="leadership" class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-16 space-y-4">
      <span class="text-xs font-semibold uppercase tracking-widest text-terracotta">Leadership & Governance</span>
      <h2 class="text-3xl sm:text-5xl font-display-light text-ink">
        Board & leadership <span class="font-display-italic text-thread-red">experience</span>.
      </h2>
      <p class="text-sm text-ink-muted font-light leading-relaxed">
        Executive roles, board appointments, and advisory committees spanning South Africa, the SADC region, and international governance bodies. Drawn from Barbara's full CV.
      </p>
    </div>

    <!-- Horizontal Expandable Timeline -->
    <div id="leadership-timeline" data-leadership-timeline>
      {(() => {
        const items = [
          { period: "2023 – present", role: "Steering Committee, End Water Poverty", category: "Board & Advisory", current: true },
          { period: "2022 – present", role: "Steering Committee, Open Government Partnership", category: "Board & Advisory", current: true },
          { period: "2022 – 2025", role: "Member, National Anti-Corruption Advisory Committee, South Africa", category: "Board & Advisory", current: false },
          { period: "2019 – present", role: "Executive Director, Water Integrity Network (WIN); Independent Consultant", category: "Executive", current: true },
          { period: "2019 – present", role: "Sanitation and Water for All — Chair, Finance & Governance Sub-Committee; member, Executive Oversight Committee & Steering Committee", category: "Board & Advisory", current: true },
          { period: "2019 – present", role: "Steering Committee, OECD Water Governance Initiative", category: "Board & Advisory", current: true },
          { period: "2019 – 2021", role: "Member, Committee of Experts to the Minister of Human Settlements, Water and Sanitation, South Africa", category: "Board & Advisory", current: false },
          { period: "2015 – 2018", role: "Chairperson, Water Research Commission of South Africa", category: "Board & Advisory", current: false },
          { period: "2013 – 2018", role: "Executive Director, Pegasys Institute", category: "Executive", current: false },
          { period: "2007 – 2018", role: "Senior Consultant & Practice Director, Pegasys Strategy and Development", category: "Executive", current: false },
          { period: "2002 – 2007", role: "Deputy Director-General: Policy & Regulation, South Africa Department of Water Affairs and Forestry", category: "Government", current: false },
          { period: "1998 – 2002", role: "Chief Director: Water Use & Conservation, South Africa Department of Water Affairs and Forestry", category: "Government", current: false },
          { period: "1995 – 1998", role: "Advisor to the Minister of Water Affairs and Forestry, South Africa", category: "Government", current: false },
          { period: "1995", role: "Head of Environmental Unit, Gauteng Provincial Government", category: "Government", current: false },
          { period: "Former appointment", role: "Board and advisory roles, International Water Management Institute (IWMI)", category: "Board & Advisory", current: false },
          { period: "Former appointment", role: "Governance and advisory contribution, iSimangaliso World Heritage Park", category: "Board & Advisory", current: false },
        ];

        return (
          <Fragment>
            {/* Desktop/tablet: horizontal expandable timeline */}
            <div class="hidden sm:block">
              <div class="overflow-x-auto pb-4 -mx-6 px-6 lg:-mx-8 lg:px-8 scrollbar-thin">
                <div class="relative flex items-start gap-12 min-w-max py-3 px-1">
                  <div class="absolute left-0 right-0 top-[31px] h-px bg-gradient-to-r from-thread-red via-terracotta/40 to-quiet-gray/15"></div>
                  {items.map((item, i) => (
                    <button
                      type="button"
                      class="leadership-dot relative z-10 flex flex-col items-center gap-2.5 group focus:outline-none"
                      data-index={i}
                      data-current={item.current ? "true" : "false"}
                      aria-expanded={i === 0 ? "true" : "false"}
                      aria-controls={`leadership-panel-${i}`}
                    >
                      <span class="text-[10px] font-semibold uppercase tracking-wider text-ink-muted/70 group-hover:text-thread-red transition-colors whitespace-nowrap">
                        {item.period.replace(" – present", "").replace("Former appointment", "Earlier")}
                      </span>
                      <span
                        class:list={[
                          "dot-marker block rounded-full border-2 transition-all duration-200",
                          item.current
                            ? "w-3.5 h-3.5 bg-thread-red border-thread-red shadow-[0_0_0_4px_rgba(196,60,44,0.15)]"
                            : "w-3 h-3 bg-canvas border-quiet-gray/40 group-hover:border-thread-red",
                          i === 0 ? "is-active" : "",
                        ]}
                      ></span>
                    </button>
                  ))}
                </div>
              </div>

              {/* Expanding detail stage */}
              <div class="mt-2 bg-canvas-pure border border-quiet-gray/20 p-6 sm:p-8 min-h-[132px] relative overflow-hidden">
                <span class="absolute top-0 left-0 bottom-0 w-1 bg-thread-red"></span>
                {items.map((item, i) => (
                  <div
                    class:list={["leadership-panel", i === 0 ? "" : "hidden"]}
                    data-index={i}
                    id={`leadership-panel-${i}`}
                  >
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 mb-2.5">
                      <span class="text-sm font-semibold text-thread-red">{item.period}</span>
                      {item.current && (
                        <span class="text-[9px] font-bold uppercase tracking-wider text-emerald-800 bg-emerald-50 border border-emerald-300 px-1.5 py-0.5 rounded-full">
                          Ongoing
                        </span>
                      )}
                      <span class="text-[10px] font-semibold uppercase tracking-wider text-ink-muted/60">
                        &bull; {item.category}
                      </span>
                    </div>
                    <p class="text-base text-ink font-light leading-relaxed max-w-2xl">
                      {item.role}
                    </p>
                  </div>
                ))}
              </div>

              <p class="mt-3 text-[11px] text-ink-muted/60 font-light">
                Click any point on the timeline to see the full role.
              </p>
            </div>

            {/* Mobile: plain stacked list */}
            <div class="sm:hidden bg-canvas-pure border border-quiet-gray/20 divide-y divide-quiet-gray/15">
              {items.map((item) => (
                <div class="p-5">
                  <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1.5 mb-1.5">
                    <span class="text-xs font-semibold uppercase tracking-wider text-thread-red">{item.period}</span>
                    {item.current && (
                      <span class="text-[9px] font-bold uppercase tracking-wider text-emerald-800 bg-emerald-50 border border-emerald-300 px-1.5 py-0.5 rounded-full">
                        Ongoing
                      </span>
                    )}
                    <span class="text-[9px] font-semibold uppercase tracking-wider text-ink-muted/60">
                      &bull; {item.category}
                    </span>
                  </div>
                  <p class="text-sm text-ink font-light leading-relaxed">
                    {item.role}
                  </p>
                </div>
              ))}
            </div>
          </Fragment>
        );
      })()}
    </div>
  </section>

  <script>
    document.querySelectorAll('[data-leadership-timeline]').forEach((root) => {
      const dots = root.querySelectorAll('.leadership-dot');
      const panels = root.querySelectorAll('.leadership-panel');
      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = dot.getAttribute('data-index');
          dots.forEach((d) => {
            const marker = d.querySelector('.dot-marker');
            const active = d === dot;
            d.setAttribute('aria-expanded', active ? 'true' : 'false');
            marker?.classList.toggle('is-active', active);
          });
          panels.forEach((p) => {
            p.classList.toggle('hidden', p.getAttribute('data-index') !== idx);
          });
        });
      });
    });
  </script>

  <!-- Directors -->
  <section id="directors" class="py-24 bg-canvas-pure border-y border-quiet-gray/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-14 space-y-4">
        <span class="text-xs font-semibold uppercase tracking-widest text-terracotta">Governance</span>
        <h2 class="text-3xl sm:text-5xl font-display-light text-ink">
          Directors of <span class="font-display-italic text-thread-red">Red Thread</span>.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-8 bg-canvas border border-quiet-gray/20 space-y-4">
          <div class="flex items-center gap-3 pb-4 border-b border-quiet-gray/15">
            <div class="w-12 h-12 bg-paper-gray border border-quiet-gray/30 flex items-center justify-center font-serif text-xl font-semibold text-ink">
              FM
            </div>
            <div>
              <h3 class="font-serif text-xl font-semibold text-ink">Frank Meintjies</h3>
              <span class="text-[11px] font-semibold uppercase tracking-wider text-terracotta">Director</span>
            </div>
          </div>
          <p class="text-sm text-ink-muted font-light leading-relaxed">
            Director of Red Thread NPC, contributing governance oversight and strategic direction to the organisation's work in water integrity, coaching, and creative practice.
          </p>
        </div>

        <div class="p-8 bg-canvas border border-quiet-gray/20 space-y-4">
          <div class="flex items-center gap-3 pb-4 border-b border-quiet-gray/15">
            <div class="w-12 h-12 bg-paper-gray border border-quiet-gray/30 flex items-center justify-center font-serif text-xl font-semibold text-ink">
              ST
            </div>
            <div>
              <h3 class="font-serif text-xl font-semibold text-ink">Sheila Tyeku</h3>
              <span class="text-[11px] font-semibold uppercase tracking-wider text-terracotta">Director</span>
            </div>
          </div>
          <p class="text-sm text-ink-muted font-light leading-relaxed">
            Director of Red Thread NPC, supporting governance, accountability, and the organisation's mission to turn testimony into transformation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Publications & Books Highlight (From CV) -->
  <section id="publications" class="py-20 bg-paper-gray/40 border-t border-quiet-gray/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12 space-y-3">
        <span class="text-xs font-semibold uppercase tracking-widest text-terracotta">Scholarship & Literature</span>
        <h2 class="text-3xl sm:text-4xl font-display-light text-ink">
          Selected publications & <span class="font-display-italic text-thread-red">writings</span>.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-ink-muted">
        <div class="p-6 bg-canvas border border-quiet-gray/20 space-y-2">
          <span class="font-semibold text-ink text-sm block">Principles and Legal Tools for Equitable Water Resource Allocation (2024)</span>
          <p>van Koppen, Mukuyu, Murombo, Jacobs-Mata, Molwantwa, Dini, Sawunyama, Schreiner & Skosana. <em>International Journal of Water Resources Development</em>.</p>
        </div>

        <div class="p-6 bg-canvas border border-quiet-gray/20 space-y-2">
          <span class="font-semibold text-ink text-sm block">The Farmer-led Irrigation Development Guide (2021)</span>
          <p>Izzi, Denison & Veldwisch (eds), collaborating author Barbara Schreiner. <em>The World Bank, Washington DC</em>.</p>
        </div>

        <div class="p-6 bg-canvas border border-quiet-gray/20 space-y-2">
          <span class="font-semibold text-ink text-sm block">Rights-based Freshwater Governance for the 21st Century (2021)</span>
