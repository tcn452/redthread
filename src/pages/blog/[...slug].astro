---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://redthread-zeta.vercel.app';
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.excerpt,
  "image": post.data.coverImage ? new URL(post.data.coverImage, siteUrl).toString() : `${siteUrl}/images/logo.jpg`,
  "datePublished": post.data.publishedDate,
  "author": {
    "@type": "Person",
    "name": post.data.author || "Barbara Schreiner"
  },
  "publisher": {
    "@type": "NGO",
    "name": "Red Thread NPC",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/images/logo.jpg`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": new URL(Astro.url.pathname, siteUrl).toString()
  }
};
---

<BaseLayout
  title={`${post.data.title} | Red Thread NPC`}
  description={post.data.excerpt}
  image={post.data.coverImage}
  type="article"
  jsonLd={articleSchema}
>
  <article class="pt-16 pb-28">
    <!-- Article Header -->
    <header class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <div class="flex items-center justify-center gap-2 text-xs">
        <a href="/blog" class="text-ink-muted hover:text-thread-red transition-colors">&larr; Back to Bits & Blogs</a>
        <span class="text-quiet-gray">&bull;</span>
        <span class="text-terracotta font-semibold uppercase tracking-widest text-[11px]">{post.data.category}</span>
        <span class="text-quiet-gray">&bull;</span>
        <span class="text-ink-muted">{post.data.publishedDate}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-display-light text-ink tracking-tight leading-tight">
        {post.data.title}
      </h1>

      <p class="text-base sm:text-lg text-ink-muted font-light max-w-2xl mx-auto leading-relaxed">
        {post.data.excerpt}
      </p>

      <div class="pt-2 flex items-center justify-center gap-4 text-xs text-ink-muted">
        <span>Written by <strong class="text-ink font-medium">{post.data.author}</strong></span>
        {post.data.readTime && (
          <>
            <span>&bull;</span>
            <span>{post.data.readTime}</span>
          </>
        )}
      </div>
    </header>

    <!-- Cover Image (if available) -->
    {post.data.coverImage && (
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 mb-16">
        <div class="aspect-[21/9] sm:aspect-[24/10] w-full overflow-hidden bg-paper-gray border border-quiet-gray/20">
          <img
            src={post.data.coverImage}
            alt={post.data.title}
            width="1600"
            height="1066"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    )}

    <!-- Article Content -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-stone prose-lg max-w-none font-light leading-relaxed prose-headings:font-serif prose-headings:font-normal prose-h2:text-3xl prose-h3:text-2xl prose-h2:text-ink prose-h3:text-ink prose-blockquote:border-l-2 prose-blockquote:border-thread-red prose-blockquote:bg-paper-gray/40 prose-blockquote:py-3 prose-blockquote:px-6 prose-blockquote:italic prose-blockquote:font-serif prose-a:text-thread-red prose-a:underline hover:prose-a:text-thread-crimson">
        <Content />
      </div>

      <!-- Author Bio Footer Box -->
      <div class="mt-16 pt-10 border-t border-quiet-gray/20 flex flex-col sm:flex-row items-center gap-6 bg-canvas-pure p-8 border border-quiet-gray/30">
        <div class="w-20 h-20 overflow-hidden shrink-0 border border-quiet-gray/30 bg-paper-gray">
          <img src="/images/logo.webp" width="1024" height="1024" alt="Red Thread mark" class="w-full h-full object-cover" />
        </div>
        <div class="space-y-2 text-center sm:text-left">
          <h4 class="font-serif text-xl font-semibold text-ink">Barbara Schreiner</h4>
          <p class="text-xs text-ink-muted leading-relaxed font-light">
            Founder of Red Thread NPC, Executive Director of the Water Integrity Network, writer, cultural activist, and transformational coach. 30+ years in international water governance and social justice.
          </p>
          <div class="pt-1 flex flex-wrap justify-center sm:justify-start gap-4 text-xs font-semibold">
            <a href="/contact#consultation" class="text-thread-red hover:underline">Initial Consultation &rarr;</a>
            <a href="/about" class="text-ink-muted hover:text-ink">Full Biography &rarr;</a>
            <a
              href="https://www.linkedin.com/in/barbara-schreiner-23a8b512/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#0A66C2] hover:text-[#004182] inline-flex items-center gap-1.5"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
              <span>LinkedIn &rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Share / Next Step -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-between gap-4 p-6 bg-paper-gray/50 border border-quiet-gray/20 text-xs">
        <span class="text-ink-muted">Found this insightful? Share or reach out:</span>
        <div class="flex items-center gap-3">
          <a
            href={`https://wa.me/?text=${encodeURIComponent(post.data.title + ' - ' + Astro.url.href)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="editorial-btn px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-medium border border-emerald-600"
          >
            Share on WhatsApp
          </a>
          <a
            href="/contact"
            class="editorial-btn px-4 py-2 bg-ink hover:bg-thread-crimson text-canvas font-medium border border-ink"
          >
            Connect with Barbara
          </a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
