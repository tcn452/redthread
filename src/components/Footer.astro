---
const currentYear = new Date().getFullYear();
---

<footer class="bg-ink text-white pt-16 pb-12 border-t-4 border-thread-red">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-white/15">
      
      <!-- Column 1: Brand & Purpose -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 overflow-hidden border border-white/30 bg-white shrink-0">
            <img src="/images/logo.jpg" alt="Red Thread Logo" class="w-full h-full object-cover" />
          </div>
          <div>
            <div class="flex items-baseline gap-2">
              <span class="font-serif text-2xl font-bold text-white tracking-tight">Red Thread</span>
              <span class="text-xs font-sans font-light uppercase tracking-wider text-white/70">NPC</span>
            </div>
            <span class="text-xs text-amber-300/90 font-light block mt-0.5">
              Non-Profit Company &bull; South Africa
            </span>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-amber-100/90 italic font-serif">
          &ldquo;Weaving Stories, Empowering Voices.&rdquo;
        </p>
        <p class="text-xs text-white/85 leading-relaxed font-light">
          At Red Thread we turn testimony into transformation. Using creative, people-centred methods, we enable individuals and groups to find their voice, whether in search of personal development or the creation of a more just, equal society.
        </p>
      </div>

      <!-- Column 2: The Three Pillars -->
      <div class="space-y-3">
        <h4 class="font-serif text-sm font-semibold text-white tracking-wider uppercase pb-2 border-b border-white/10 flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-thread-red"></span>
          Core Practices
        </h4>
        <ul class="space-y-2.5 text-xs text-white/85">
          <li>
            <a href="/services/craftivism-and-creative-practice" class="group flex items-center gap-2 text-white/85 hover:text-amber-300 transition-colors py-0.5">
              <span class="text-amber-400 group-hover:text-white group-hover:translate-x-0.5 transition-transform font-bold text-sm">›</span>
              <span class="group-hover:underline underline-offset-4 decoration-amber-400/40">Creativity for Change (Craftivism)</span>
            </a>
          </li>
          <li>
            <a href="/services/coaching-for-change" class="group flex items-center gap-2 text-white/85 hover:text-amber-300 transition-colors py-0.5">
              <span class="text-amber-400 group-hover:text-white group-hover:translate-x-0.5 transition-transform font-bold text-sm">›</span>
              <span class="group-hover:underline underline-offset-4 decoration-amber-400/40">Coaching for Change (Individual & Team)</span>
            </a>
          </li>
          <li>
            <a href="/services/water-governance-consulting" class="group flex items-center gap-2 text-white/85 hover:text-amber-300 transition-colors py-0.5">
              <span class="text-amber-400 group-hover:text-white group-hover:translate-x-0.5 transition-transform font-bold text-sm">›</span>
              <span class="group-hover:underline underline-offset-4 decoration-amber-400/40">Consulting for Change (Water Governance)</span>
            </a>
          </li>
          <li>
            <a href="/about#values" class="group flex items-center gap-2 text-white/85 hover:text-amber-300 transition-colors py-0.5">
              <span class="text-amber-400 group-hover:text-white group-hover:translate-x-0.5 transition-transform font-bold text-sm">›</span>
              <span class="group-hover:underline underline-offset-4 decoration-amber-400/40">Mission, Vision & Values</span>
            </a>
          </li>
          <li>
            <a href="/about#publications" class="group flex items-center gap-2 text-white/85 hover:text-amber-300 transition-colors py-0.5">
              <span class="text-amber-400 group-hover:text-white group-hover:translate-x-0.5 transition-transform font-bold text-sm">›</span>
              <span class="group-hover:underline underline-offset-4 decoration-amber-400/40">Publications & Research</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Direct Contact -->
      <div class="space-y-3">
        <h4 class="font-serif text-sm font-semibold text-white tracking-wider uppercase pb-2 border-b border-white/10 flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-thread-red"></span>
          Get in Touch
        </h4>
        <div class="space-y-3 text-xs text-white/85">
          <div>
            <span class="block text-[10px] uppercase font-semibold text-amber-300 tracking-wider mb-0.5">Phone & WhatsApp</span>
            <a href="tel:+27828074342" class="text-white hover:text-amber-300 transition-colors font-medium text-xs">
              +27 82 807 4342
            </a>
          </div>
          <div>
            <span class="block text-[10px] uppercase font-semibold text-amber-300 tracking-wider mb-0.5">Email</span>
            <a href="mailto:barbaraschreinerz@gmail.com" class="text-white hover:text-amber-300 transition-colors font-medium text-xs break-all">
              barbaraschreinerz@gmail.com
            </a>
          </div>
          <div>
            <span class="block text-[10px] uppercase font-semibold text-amber-300 tracking-wider mb-0.5">Availability</span>
            <p class="text-[11px] text-white/80 leading-relaxed font-light">
              In-person across South Africa & internationally online via video or WhatsApp.
            </p>
          </div>
          <div class="pt-1">
            <a
              href="https://wa.me/27828074342?text=Hello%20Barbara,%20I'd%20like%20to%20connect%20with%20RedThread."
              target="_blank"
              rel="noopener noreferrer"
              class="editorial-btn inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold uppercase tracking-wider text-emerald-300 bg-emerald-950/80 border border-emerald-500/50 hover:bg-emerald-900 transition-colors"
            >
              <span class="w-2 h-2 bg-emerald-400"></span>
              <span>WhatsApp Direct Message</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Column 4: Quick Links -->
      <div class="space-y-3">
        <h4 class="font-serif text-sm font-semibold text-white tracking-wider uppercase pb-2 border-b border-white/10 flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-thread-red"></span>
          Explore
        </h4>
        <ul class="space-y-2.5 text-xs">
          <li>
            <a href="/" class="group flex items-center gap-2 text-white/85 hover:text-amber-300 transition-colors py-0.5">
              <span class="w-1.5 h-1.5 bg-thread-red group-hover:bg-amber-300 transition-colors"></span>
              <span class="group-hover:translate-x-1 transition-transform">Home</span>
            </a>
          </li>
          <li>
            <a href="/about" class="group flex items-center gap-2 text-white/85 hover:text-amber-300 transition-colors py-0.5">
              <span class="w-1.5 h-1.5 bg-thread-red group-hover:bg-amber-300 transition-colors"></span>
              <span class="group-hover:translate-x-1 transition-transform">About Barbara</span>
            </a>
          </li>
          <li>
            <a href="/services" class="group flex items-center gap-2 text-white/85 hover:text-amber-300 transition-colors py-0.5">
              <span class="w-1.5 h-1.5 bg-thread-red group-hover:bg-amber-300 transition-colors"></span>
              <span class="group-hover:translate-x-1 transition-transform">Services & Offerings</span>
            </a>
          </li>
          <li>
            <a href="/blog" class="group flex items-center gap-2 text-white/85 hover:text-amber-300 transition-colors py-0.5">
              <span class="w-1.5 h-1.5 bg-thread-red group-hover:bg-amber-300 transition-colors"></span>
              <span class="group-hover:translate-x-1 transition-transform">Bits & Blogs</span>
            </a>
          </li>
          <li>
            <a href="/contact" class="group flex items-center gap-2 text-white/85 hover:text-amber-300 transition-colors py-0.5">
              <span class="w-1.5 h-1.5 bg-thread-red group-hover:bg-amber-300 transition-colors"></span>
              <span class="group-hover:translate-x-1 transition-transform">Contact & Consultation</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-white/80 gap-4">
      <p class="leading-relaxed">
        &copy; {currentYear} RedThread NPC. All rights reserved. Registered Non-Profit Company in South Africa.
      </p>
      <div class="flex items-center gap-2 text-amber-200/90 font-serif italic text-xs">
        <span>Deep listening</span>
        <span>&bull;</span>
        <span>Respect</span>
        <span>&bull;</span>
        <span>Honesty</span>
      </div>
    </div>
  </div>
</footer>
