---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://redthread-zeta.vercel.app';
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Barbara Schreiner",
  "jobTitle": "Founder & Executive Director, Red Thread NPC",
  "description": "Writer, transformational coach, textile artist, and senior water governance advisor with over 30 years of public policy leadership in South Africa and internationally.",
  "url": new URL(Astro.url.pathname, siteUrl).toString(),
  "worksFor": {
    "@type": "NGO",
    "name": "Red Thread NPC",
    "url": siteUrl
  },
  "knowsAbout": [
    "Transformational Leadership Coaching",
    "Water Governance & Integrity",
    "Chilean Arpillera & Textile Craftivism",
    "Public Sector Policy Frameworks",
    "Creative Writing & Collective Healing"
  ]
};
---

<BaseLayout
  title="About Barbara Schreiner & Red Thread NPC"
  description="Bringing 30+ years of senior water governance, published literature, Chilean arpillera craftivism, and transformational leadership coaching to the table."
  jsonLd={personSchema}
>
  <!-- Hero Section -->
  <section class="pt-16 pb-20 md:pt-24 md:pb-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="max-w-4xl space-y-6">
      <span class="reveal text-xs font-semibold uppercase tracking-widest text-terracotta">About the Founder</span>
      <h1 class="reveal delay-100 text-4xl sm:text-6xl md:text-7xl font-display-light text-ink tracking-tight">
        Bringing a long career to the <span class="font-display-italic text-thread-red">table</span>.
      </h1>
      <p class="reveal delay-200 text-lg sm:text-xl text-ink-muted font-light leading-relaxed">
        Moving between worlds that aren’t supposed to overlap: government offices and theatre back rooms, water governance and writing workshops, senior management and needle and thread.
      </p>
    </div>
  </section>

  <!-- Narrative & Portrait Section -->
  <section class="pb-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Portrait & Quick Facts -->
      <div class="reveal lg:col-span-5 space-y-8 lg:sticky lg:top-28">
        <div class="aspect-[3/4] w-full border border-quiet-gray/20 bg-paper-gray flex flex-col justify-between p-8 sm:p-10">
          <img
            src="/images/logo.webp"
            width="1024"
            height="1024"
            alt="Red Thread mark"
            class="w-24 h-24 object-contain border border-quiet-gray/30 bg-canvas-pure"
          />
          <div class="space-y-3">
            <p class="font-display-italic text-4xl text-ink">Barbara Schreiner</p>
            <p class="text-xs font-semibold uppercase tracking-widest text-terracotta">Founder & Executive Director</p>
          </div>
        </div>

        <div class="p-6 bg-paper-gray/50 border border-quiet-gray/20 space-y-4">
          <h3 class="font-serif text-lg text-ink font-semibold">At a Glance</h3>
          <ul class="space-y-3 text-xs text-ink-muted">
            <li class="flex items-start gap-2">
              <span class="text-thread-red font-bold">›</span>
              <span><strong>Current Role:</strong> Founder of Red Thread NPC & Executive Director of the Water Integrity Network (WIN).</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-thread-red font-bold">›</span>
              <span><strong>Government Experience:</strong> Former Deputy Director General at South Africa's Department of Water Affairs & Forestry.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-thread-red font-bold">›</span>
              <span><strong>Cultural Activism:</strong> Writer, poet, novel author, and arpillera textile artist.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-thread-red font-bold">›</span>
              <span><strong>Education:</strong> MPhil in Environmental Science (Distinction, UCT), MA (Lancaster, UK), BA Hons (Natal).</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Extended Personal Copy from Original Site + CV -->
      <div class="lg:col-span-7 space-y-8 text-base text-ink-muted font-light leading-relaxed">
        <div class="space-y-6">
          <p class="text-lg text-ink font-normal leading-relaxed">
            I’ve spent most of my working life moving between worlds that aren’t supposed to overlap: government offices and theatre back rooms, water governance and writing workshops, senior management and needle and thread.
          </p>

          <p>
            For over thirty years I’ve worked in water &mdash; as <strong>Deputy Director General at South Africa’s Department of Water Affairs</strong>, and more recently as <strong>Executive Director of the Water Integrity Network (WIN)</strong>, an international NGO working globally on water and sanitation governance, anti-corruption, and integrity.
          </p>

          <p>
            I’ve published widely on water policy, governance, legislation and practice with a focus on equity, gender transformation and poverty eradication. In the process I have gained deep experience on enabling people and organisations to work better across South Africa, Germany, and global institutions.
          </p>

          <div class="py-4 my-4 border-y border-quiet-gray/20 italic font-serif text-ink text-lg leading-relaxed">
            &ldquo;Before any of that, and running alongside it, I have been a writer and a cultural activist.&rdquo;
          </div>

          <p>
            I edited a collection of women’s prison writings, ran creative writing workshops across South Africa for the Congress of South African Writers (COSAW), led a national writers’ magazine’s editorial collective for six years, and published two novels, a biography, and poetry along the way.
          </p>

          <p>
            My textile art draws on the <strong>arpillera tradition</strong> &mdash; using cloth and thread to tell stories of injustice, discrimination, trauma, and resistance. Objects become arguments and evidence, inviting viewers to confront what official narratives leave unaddressed.
          </p>

          <p>
            More recently, I trained as a coach and counsellor, because thirty years of watching capable people burn out or lose their way convinced me that leadership and institutions are only ever as good as the people inside them, and those people need somewhere to reflect and grow.
          </p>
        </div>

        <!-- Personal Signoff from Original Site -->
        <div class="pt-6 border-t border-quiet-gray/20">
          <p class="font-serif text-xl text-ink italic mb-1">
            I look forward to engaging with you,
          </p>
          <span class="font-serif text-2xl font-bold text-thread-crimson tracking-tight">
            Barbara
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission, Vision, and Values Section (Original Site) -->
  <section id="values" class="py-24 bg-canvas-pure border-y border-quiet-gray/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="reveal text-center max-w-3xl mx-auto mb-16 space-y-4">
        <span class="text-xs font-semibold uppercase tracking-widest text-terracotta">Our Guiding Compass</span>
        <h2 class="text-4xl sm:text-5xl font-display-light text-ink">
          Mission, Vision & <span class="font-display-italic text-thread-red">Values</span>.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Mission -->
        <div class="reveal delay-100 p-8 bg-canvas border border-quiet-gray/20 flex flex-col justify-between">
          <div>
            <span class="text-[11px] font-semibold uppercase tracking-widest text-terracotta block mb-3">Our Mission</span>
            <h3 class="font-serif text-2xl text-ink font-semibold mb-4">Agency & Expression</h3>
            <p class="text-sm text-ink-muted leading-relaxed font-light">
              &ldquo;To turn testimony into transformation using creative, people-centred methods that enable individuals, communities, and public institutions to find their voice, confront systemic obstacles, and build sustainable pathways for change.&rdquo;
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-quiet-gray/15 text-xs text-thread-red font-medium">
            Voice, Testimony & Renewal
          </div>
        </div>

        <!-- Vision -->
        <div class="reveal delay-200 p-8 bg-canvas border border-quiet-gray/20 flex flex-col justify-between">
          <div>
            <span class="text-[11px] font-semibold uppercase tracking-widest text-terracotta block mb-3">Our Vision</span>
            <h3 class="font-serif text-2xl text-ink font-semibold mb-4">Equity & Integrity</h3>
            <p class="text-sm text-ink-muted leading-relaxed font-light">
              &ldquo;A society grounded in human dignity and justice, where untold stories find fearless expression, vital resources are safeguarded with unyielding integrity, and creative dialogue inspires lasting social change.&rdquo;
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-quiet-gray/15 text-xs text-thread-red font-medium">
            Dignity, Justice & Governance
          </div>
        </div>

        <!-- Values -->
        <div class="reveal delay-300 p-8 bg-canvas border border-quiet-gray/20 flex flex-col justify-between">
          <div>
            <span class="text-[11px] font-semibold uppercase tracking-widest text-terracotta block mb-3">Core Values</span>
            <h3 class="font-serif text-2xl text-ink font-semibold mb-4">The Ethical Foundation</h3>
            <ul class="space-y-3 text-sm text-ink-muted font-light">
              <li class="flex items-center gap-2.5">
                <span class="w-1.5 h-1.5 bg-thread-red shrink-0"></span>
                <strong class="text-ink font-medium">Deep listening without preconceptions</strong>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="w-1.5 h-1.5 bg-thread-red shrink-0"></span>
                <strong class="text-ink font-medium">Respect for lived experience</strong>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="w-1.5 h-1.5 bg-thread-red shrink-0"></span>
                <strong class="text-ink font-medium">Intellectual & institutional honesty</strong>
              </li>
            </ul>
          </div>
          <div class="mt-8 pt-4 border-t border-quiet-gray/15 text-xs text-thread-red font-medium">
            Grounded in Integrity
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Professional CV & Career Timeline Integration -->
  <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-16 space-y-4">
      <span class="text-xs font-semibold uppercase tracking-widest text-terracotta">Leadership & Governance</span>
      <h2 class="text-3xl sm:text-5xl font-display-light text-ink">
        Professional leadership <span class="font-display-italic text-thread-red">track record</span>.
      </h2>
      <p class="text-sm text-ink-muted font-light leading-relaxed">
        Key appointments, advisory committees, and public sector leadership spanning South Africa, the SADC region, and international governance bodies.
      </p>
    </div>

    <!-- Timeline / Roles Grid -->
    <div class="space-y-6">
      <div class="p-6 sm:p-8 bg-canvas-pure border border-quiet-gray/20 grid grid-cols-1 md:grid-cols-12 gap-6 items-baseline">
        <div class="md:col-span-3 text-xs font-semibold uppercase tracking-wider text-thread-red">
          2019 &ndash; Present
        </div>
        <div class="md:col-span-9 space-y-1">
          <h4 class="font-serif text-xl font-medium text-ink">Executive Director &bull; Water Integrity Network (WIN)</h4>
          <p class="text-xs text-ink-muted leading-relaxed font-light">
            Leading an international NGO operating across 7+ countries championing anti-corruption, financial transparency, and integrity systems in water and sanitation.
          </p>
        </div>
      </div>

      <div class="p-6 sm:p-8 bg-canvas-pure border border-quiet-gray/20 grid grid-cols-1 md:grid-cols-12 gap-6 items-baseline">
        <div class="md:col-span-3 text-xs font-semibold uppercase tracking-wider text-thread-red">
          2022 &ndash; 2025
        </div>
        <div class="md:col-span-9 space-y-1">
          <h4 class="font-serif text-xl font-medium text-ink">Member &bull; National Anti-Corruption Advisory Committee (NACAC), South Africa</h4>
          <p class="text-xs text-ink-muted leading-relaxed font-light">
            Appointed to advise the President and government on national anti-corruption strategy, integrity architecture, and whistleblower protection.
          </p>
        </div>
      </div>

      <div class="p-6 sm:p-8 bg-canvas-pure border border-quiet-gray/20 grid grid-cols-1 md:grid-cols-12 gap-6 items-baseline">
        <div class="md:col-span-3 text-xs font-semibold uppercase tracking-wider text-thread-red">
          2019 &ndash; Present
        </div>
        <div class="md:col-span-9 space-y-1">
          <h4 class="font-serif text-xl font-medium text-ink">Steering Committee &bull; OECD Water Governance Initiative & Open Government Partnership</h4>
          <p class="text-xs text-ink-muted leading-relaxed font-light">
            International multi-stakeholder governance advising on international benchmarks, public participation, and transparency mechanisms in natural resource management.
          </p>
        </div>
      </div>

      <div class="p-6 sm:p-8 bg-canvas-pure border border-quiet-gray/20 grid grid-cols-1 md:grid-cols-12 gap-6 items-baseline">
        <div class="md:col-span-3 text-xs font-semibold uppercase tracking-wider text-thread-red">
          2002 &ndash; 2007
        </div>
        <div class="md:col-span-9 space-y-1">
          <h4 class="font-serif text-xl font-medium text-ink">Deputy Director General: Policy & Regulation &bull; Department of Water Affairs, South Africa</h4>
          <p class="text-xs text-ink-muted leading-relaxed font-light">
            Oversaw the post-apartheid transformation of South African water policy and legislation, pricing strategy, compulsory licensing, and equitable access frameworks.
          </p>
        </div>
      </div>

      <div class="p-6 sm:p-8 bg-canvas-pure border border-quiet-gray/20 grid grid-cols-1 md:grid-cols-12 gap-6 items-baseline">
        <div class="md:col-span-3 text-xs font-semibold uppercase tracking-wider text-thread-red">
          2015 &ndash; 2018
        </div>
        <div class="md:col-span-9 space-y-1">
          <h4 class="font-serif text-xl font-medium text-ink">Chairperson of the Board &bull; Water Research Commission of South Africa</h4>
          <p class="text-xs text-ink-muted leading-relaxed font-light">
            Strategic stewardship of South Africa's premier national water knowledge, research funding, and innovation institution.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Publications & Books Highlight (From CV) -->
  <section id="publications" class="py-20 bg-paper-gray/40 border-t border-quiet-gray/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12 space-y-3">
        <span class="text-xs font-semibold uppercase tracking-widest text-terracotta">Scholarship & Literature</span>
        <h2 class="text-3xl sm:text-4xl font-display-light text-ink">
          Selected publications & <span class="font-display-italic text-thread-red">writings</span>.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-ink-muted">
        <div class="p-6 bg-canvas border border-quiet-gray/20 space-y-2">
          <span class="font-semibold text-ink text-sm block">Principles and Legal Tools for Equitable Water Resource Allocation (2024)</span>
          <p>van Koppen, Mukuyu, Murombo, Jacobs-Mata, Molwantwa, Dini, Sawunyama, Schreiner & Skosana. <em>International Journal of Water Resources Development</em>.</p>
        </div>

        <div class="p-6 bg-canvas border border-quiet-gray/20 space-y-2">
          <span class="font-semibold text-ink text-sm block">The Farmer-led Irrigation Development Guide (2021)</span>
          <p>Izzi, Denison & Veldwisch (eds), collaborating author Barbara Schreiner. <em>The World Bank, Washington DC</em>.</p>
        </div>

        <div class="p-6 bg-canvas border border-quiet-gray/20 space-y-2">
          <span class="font-semibold text-ink text-sm block">Rights-based Freshwater Governance for the 21st Century (2021)</span>
          <p>van Koppen, Mehta, Hellum, Derman & Schreiner. <em>Freshwater Governance for the 21st Century</em>, Springer.</p>
        </div>

        <div class="p-6 bg-canvas border border-quiet-gray/20 space-y-2">
          <span class="font-semibold text-ink text-sm block">Water Pricing: The Case of South Africa (2015)</span>
          <p>Schreiner, B. In A. Dinar et al. (eds), <em>Water Pricing Experiences and Innovations</em>, Springer.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
