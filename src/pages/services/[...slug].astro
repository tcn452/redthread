---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map(service => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);

const allServices = (await getCollection('services')).sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
const otherServices = allServices.filter(s => s.id !== service.id);

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://redthread-zeta.vercel.app';
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.data.title,
  "description": service.data.shortDescription,
  "serviceType": service.data.tagline || service.data.title,
  "provider": {
    "@type": "NGO",
    "name": "Red Thread NPC",
    "url": siteUrl
  },
  "areaServed": "Global",
  "url": new URL(Astro.url.pathname, siteUrl).toString()
};
---

<BaseLayout
  title={`${service.data.title} | Red Thread NPC`}
  description={service.data.shortDescription || `${service.data.title} at Red Thread NPC.`}
  image={service.data.coverImage}
  jsonLd={serviceSchema}
>
  <!-- Service Hero Section -->
  <header class="pt-16 pb-12 md:pt-20 md:pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-b border-quiet-gray/20">
    <div class="max-w-4xl space-y-4">
      <div class="flex items-center gap-3">
        <a href="/services" class="text-xs font-semibold uppercase tracking-widest text-ink-muted hover:text-thread-red transition-colors flex items-center gap-1">
          <span>&larr;</span>
          <span>All Practices</span>
        </a>
        <span class="text-quiet-gray/40">&bull;</span>
        <span class="text-xs font-semibold uppercase tracking-widest text-terracotta">
          {service.data.tagline || 'Practice'}
        </span>
      </div>

      <h1 class="text-4xl sm:text-6xl md:text-7xl font-display-light text-ink tracking-tight">
        {service.data.title}
      </h1>

      {service.data.shortDescription && (
        <p class="text-lg sm:text-xl text-ink-muted font-light leading-relaxed max-w-3xl pt-2">
          {service.data.shortDescription}
        </p>
      )}

      <div class="flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center gap-3 sm:gap-4 pt-4">
        <a
          href={`/contact?service=${encodeURIComponent(service.data.title)}#consultation`}
          class="editorial-btn w-full sm:w-auto px-7 py-3.5 bg-ink hover:bg-thread-crimson text-white text-xs uppercase tracking-widest font-semibold text-center"
        >
          Schedule an Exploration
        </a>
        <a
          href={`https://wa.me/27828074342?text=${encodeURIComponent(`Hello Barbara, I am inquiring about your practice: ${service.data.title}.`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-btn w-full sm:w-auto px-6 py-3.5 text-emerald-900 hover:text-emerald-950 text-xs font-medium flex items-center justify-center gap-2 border border-emerald-300 bg-emerald-50/60 text-center"
        >
          <span class="w-1.5 h-1.5 bg-emerald-600"></span>
          <span>Message on WhatsApp</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Service Main Content Layout -->
  <section class="py-16 md:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Rich Elaborated Content -->
      <main class="lg:col-span-8">
        {service.data.coverImage && (
          <div class="group aspect-[16/9] w-full overflow-hidden bg-paper-gray border border-quiet-gray/20 mb-12">
            <img
              src={service.data.coverImage}
              alt={service.data.title}
              class="w-full h-full object-cover hover-img-zoom group-hover:scale-[1.02]"
            />
          </div>
        )}

        <div class="prose prose-stone prose-lg max-w-none font-light leading-relaxed prose-headings:font-serif prose-headings:font-normal prose-h2:text-3xl prose-h2:text-ink prose-h2:mt-10 prose-h2:mb-4 prose-h3:text-2xl prose-h3:text-ink prose-h3:mt-8 prose-h3:mb-3 prose-blockquote:border-l-2 prose-blockquote:border-thread-red prose-blockquote:bg-paper-gray/40 prose-blockquote:py-3 prose-blockquote:px-6 prose-blockquote:italic prose-blockquote:font-serif prose-a:text-thread-red prose-a:underline hover:prose-a:text-thread-crimson prose-li:my-1">
          <Content />
        </div>

        <!-- Direct Action Banner at Bottom of Content -->
        <div class="mt-16 pt-8 border-t border-quiet-gray/20 p-8 bg-paper-gray/50 border border-quiet-gray/30 space-y-4">
          <span class="text-xs font-semibold uppercase tracking-widest text-terracotta block">
            Next Steps in this Practice
          </span>
          <h3 class="font-serif text-2xl text-ink font-medium">
            Ready to discuss {service.data.title.toLowerCase()}?
          </h3>
          <p class="text-xs text-ink-muted leading-relaxed font-light max-w-2xl">
            We offer a complimentary 15-minute introductory conversation to listen to your needs, explore context, and shape an engagement that aligns with your goals.
          </p>
          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a
              href={`/contact?service=${encodeURIComponent(service.data.title)}#consultation`}
              class="editorial-btn px-6 py-3 bg-thread-red hover:bg-thread-crimson text-white text-xs uppercase tracking-widest font-semibold border border-thread-red"
            >
              Book 15-Minute Session
            </a>
            <a
              href="tel:+27828074342"
              class="editorial-btn px-6 py-3 bg-canvas border border-quiet-gray/30 hover:border-ink text-ink text-xs uppercase tracking-widest font-semibold"
            >
              Call +27 82 807 4342
            </a>
          </div>
        </div>
      </main>

      <!-- Right Column: Sticky Context Sidebar -->
      <aside class="lg:col-span-4 space-y-8 sticky top-28">
        <!-- Quick Practice Index -->
        <div class="p-6 bg-canvas-pure border border-quiet-gray/30 space-y-4">
          <span class="text-[11px] font-semibold uppercase tracking-widest text-terracotta block">
            Core Practices
          </span>
          <nav class="space-y-2">
            {allServices.map((s) => {
              const isCurrent = s.id === service.id;
              return (
                <a
                  href={`/services/${s.id}`}
                  class={`block p-3 border text-xs transition-colors ${
                    isCurrent
                      ? 'border-thread-red bg-thread-red/5 font-semibold text-ink'
                      : 'border-quiet-gray/20 bg-canvas hover:border-quiet-gray/40 text-ink-muted hover:text-ink'
                  }`}
                >
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] uppercase font-mono text-terracotta">
                      {s.data.tagline || 'Practice'}
                    </span>
                    {isCurrent && <span class="text-thread-red text-[10px] font-bold">Current &rarr;</span>}
                  </div>
                  <span class="block text-sm font-serif font-medium mt-1 text-ink">
                    {s.data.title}
                  </span>
                </a>
              );
            })}
          </nav>
        </div>

        <!-- Practitioner Bio Card -->
        <div class="p-6 bg-canvas-pure border border-quiet-gray/30 space-y-3 text-xs">
          <div class="flex items-center gap-3 pb-3 border-b border-quiet-gray/15">
            <div class="w-10 h-10 overflow-hidden border border-quiet-gray/30 bg-paper-gray shrink-0">
              <img src="/images/logo.jpg" alt="Barbara Schreiner" class="w-full h-full object-cover" />
            </div>
            <div>
              <strong class="font-serif text-sm font-semibold text-ink block">Barbara Schreiner</strong>
              <span class="text-[11px] text-ink-muted">Director & Practitioner</span>
            </div>
          </div>
          <p class="text-ink-muted leading-relaxed font-light">
            30+ years in public policy, water integrity, transformational leadership coaching, and Chilean arpillera craftivism.
          </p>
          <a href="/about" class="text-thread-red hover:underline font-semibold block pt-1">
            Read Full Biography & CV &rarr;
          </a>
        </div>
      </aside>

    </div>
  </section>
</BaseLayout>
