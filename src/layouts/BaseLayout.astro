---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = "Red Thread NPC | Turning Testimony into Transformation",
  description = "Red Thread works at the intersection of craft, art, writing, and social change. Creativity, transformational coaching, and water governance consulting by Barbara Schreiner.",
  image = "/images/logo.jpg",
  type = "website",
  jsonLd
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://redthread-zeta.vercel.app';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();
const resolvedImageURL = new URL(image, siteUrl).toString();

const defaultOrgSchema = {
  "@context": "https://schema.org",
  "@type": "NGO",
  "name": "Red Thread NPC",
  "alternateName": "Red Thread",
  "url": siteUrl,
  "logo": `${siteUrl}/images/logo.jpg`,
  "image": `${siteUrl}/images/logo.jpg`,
  "description": "Red Thread works at the intersection of craft, art, writing, and social change. Creative practice, transformational coaching, and water governance consulting.",
  "founder": {
    "@type": "Person",
    "name": "Barbara Schreiner",
    "jobTitle": "Founder & Executive Director"
  },
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "ZA"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+27-82-807-4342",
    "contactType": "consultations"
  }
};
---

<!doctype html>
<html lang="en" class="h-full bg-canvas text-ink antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Barbara Schreiner" />
    <meta name="geo.region" content="ZA" />

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:site_name" content="Red Thread NPC" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImageURL} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_ZA" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImageURL} />

    <!-- Schema.org Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(defaultOrgSchema)} />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Google Fonts: Newsreader (Editorial Serif) & Plus Jakarta Sans (Clean Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,300;1,6..72,400;1,6..72,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-full flex flex-col bg-canvas selection:bg-thread-red selection:text-white">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Refero/Framer-style Scroll Reveal Observer -->
    <script>
      function initScrollReveals() {
        const reveals = document.querySelectorAll('.reveal');
        if (!reveals.length) return;

        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('active');
                obs.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.1,
            rootMargin: '0px 0px -40px 0px',
          }
        );

        reveals.forEach(el => observer.observe(el));
      }

      // Initialize on load and on dynamic navigation
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollReveals);
      } else {
        initScrollReveals();
      }
    </script>
  </body>
</html>
