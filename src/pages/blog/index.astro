---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime());

const categories = [
  { label: 'All Articles', slug: 'all' },
  { label: 'Craftivism & Art', slug: 'craftivism' },
  { label: 'Coaching & Renewal', slug: 'coaching' },
  { label: 'Water Governance', slug: 'governance' },
  { label: 'Reflections', slug: 'reflections' },
];
---

<BaseLayout
  title="Bits & Blogs | Red Thread NPC"
  description="Essays, stories, craftivism narratives, and governance insights by Barbara Schreiner."
>
  <section class="pt-16 pb-12 md:pt-24 md:pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="max-w-3xl space-y-4">
      <div class="flex items-center gap-3">
        <span class="text-xs font-semibold uppercase tracking-widest text-terracotta">Bits & Blogs</span>
        <span class="text-xs px-2.5 py-0.5 bg-paper-gray text-ink-muted border border-quiet-gray/30">
          Thought Leadership
        </span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-display-light text-ink tracking-tight">
        Stories, testimony & <span class="font-display-italic text-thread-red">reflections</span>.
      </h1>
      <p class="text-lg text-ink-muted font-light leading-relaxed">
        Writing on the Chilean arpillera lineage, creative testimony, transformational leadership coaching, and thirty years inside public water governance.
      </p>
    </div>

    <!-- Category Filter Controls (Architectural Tab Reference) -->
    <div class="mt-12 flex flex-wrap gap-2 border-b border-quiet-gray/20 pb-6">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-category={cat.slug}
          class={`filter-btn px-4 py-2 text-xs uppercase tracking-wider font-semibold transition-colors border ${
            idx === 0
              ? 'bg-ink text-canvas border-ink active-filter'
              : 'bg-canvas-pure text-ink-muted border-quiet-gray/30 hover:border-ink hover:text-ink'
          }`}
        >
          {cat.label}
        </button>
      ))}
    </div>
  </section>

  <!-- Article Grid -->
  <section class="pb-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      {sortedPosts.map(post => (
        <article data-post-category={post.data.category} class="post-card flex flex-col group">
          {post.data.coverImage && (
            <a href={`/blog/${post.id}`} class="aspect-[16/10] w-full overflow-hidden bg-paper-gray border border-quiet-gray/20 mb-4 block">
              <img
                src={post.data.coverImage}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-500"
              />
            </a>
          )}
          <div class="flex items-center gap-2 mb-2 text-xs text-ink-muted">
            <span class="text-terracotta font-semibold uppercase tracking-wider text-[10px]">
              {post.data.category}
            </span>
            <span>&bull;</span>
            <span>{post.data.publishedDate}</span>
            {post.data.readTime && (
              <>
                <span>&bull;</span>
                <span>{post.data.readTime}</span>
              </>
            )}
          </div>
          <h2 class="font-serif text-2xl font-medium text-ink group-hover:text-thread-red transition-colors mb-2 leading-snug">
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
          </h2>
          <p class="text-xs text-ink-muted leading-relaxed font-light line-clamp-3 mb-4 flex-1">
            {post.data.excerpt}
          </p>
          <div class="pt-2 border-t border-quiet-gray/10 flex items-center justify-between">
            <span class="text-xs font-medium text-ink">By {post.data.author}</span>
            <a href={`/blog/${post.id}`} class="text-xs font-semibold text-thread-red hover:underline">
              Read More &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Interactive Filtering Script -->
  <script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const postCards = document.querySelectorAll<HTMLElement>('.post-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.category;

        // Toggle active button style
        filterButtons.forEach(b => {
          b.classList.remove('bg-ink', 'text-canvas', 'border-ink', 'active-filter');
          b.classList.add('bg-canvas-pure', 'text-ink-muted', 'border-quiet-gray/30');
        });
        btn.classList.remove('bg-canvas-pure', 'text-ink-muted', 'border-quiet-gray/30');
        btn.classList.add('bg-ink', 'text-canvas', 'border-ink', 'active-filter');

        // Filter cards
        postCards.forEach(card => {
          if (cat === 'all' || card.dataset.postCategory === cat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>
