---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime()).slice(0, 3);
---

<BaseLayout
  title="Red Thread NPC | Turning Testimony into Transformation"
  description="Red Thread works at the intersection of craft, art, writing, and social change. Creativity, transformational coaching, and water governance consulting by Barbara Schreiner."
>
  <!-- 1. Hero Section: High-Impact Editorial Split Spread -->
  <section class="relative pt-8 pb-16 sm:pt-12 sm:pb-20 lg:pt-16 lg:pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- Left Column: Editorial Statement & Actions (7 cols) -->
      <div class="lg:col-span-7 space-y-6 sm:space-y-8">
        <!-- Status / Availability Signal -->
        <div class="reveal inline-flex items-center gap-2.5 px-3 py-1.5 bg-canvas-pure border border-quiet-gray/25 text-xs text-ink font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
          <span>Available for 2026 and 2027 coaching & consulting</span>
        </div>

        <!-- Main Display Typography -->
        <div class="space-y-4">
          <span class="block text-xs font-semibold uppercase tracking-[0.2em] text-terracotta">Red Thread NPC · South Africa & Global Advisory</span>
          <h1 class="reveal delay-100 text-4xl sm:text-6xl lg:text-7xl font-display-light text-ink tracking-tight leading-[1.05]">
            At Red Thread, we turn testimony into <span class="font-display-italic text-thread-red underline decoration-thread-red/30 underline-offset-8">transformation</span>.
          </h1>
        </div>

        <p class="reveal delay-200 text-base sm:text-lg lg:text-xl text-ink-muted max-w-2xl leading-relaxed font-light">
          Using creative, people-centred methods, Red Thread enables individuals and groups to find their voice &mdash; whether in search of personal renewal or confronting systemic obstacles through craftivism and policy integrity.
        </p>

        <!-- Action Controls (Strictly zero-pill architectural buttons) -->
        <div class="reveal delay-300 flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center gap-3 sm:gap-4 pt-2">
          <a
            href="/services"
            class="editorial-btn w-full sm:w-auto px-7 py-3.5 bg-ink hover:bg-thread-crimson text-white text-xs uppercase tracking-widest font-semibold text-center group"
          >
            <span>Explore Our Practices</span>
            <span class="ml-2 inline-block transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
          </a>
          <a
            href="/contact#consultation"
            class="editorial-btn w-full sm:w-auto px-7 py-3.5 bg-canvas-pure hover:bg-paper-gray text-ink border border-quiet-gray/30 text-xs uppercase tracking-widest font-semibold text-center"
          >
            Schedule a Consultation
          </a>
          <a
            href="https://wa.me/27828074342?text=Hello%20Barbara,%20I%20would%20like%20to%20connect%20with%20Red%20Thread."
            target="_blank"
            rel="noopener noreferrer"
            class="editorial-btn w-full sm:w-auto px-5 py-3.5 text-emerald-950 hover:text-emerald-900 text-xs font-medium flex items-center justify-center gap-2 border border-emerald-300/80 bg-emerald-50/70 text-center"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
            WhatsApp Barbara Directly
          </a>
        </div>
      </div>

      <!-- Right Column: Arresting Visual Anchor (5 cols) -->
      <div class="reveal delay-200 lg:col-span-5">
        <div class="relative group">
          <!-- Fine Art Frame with Refero Hairlines -->
          <div class="aspect-[4/5] w-full overflow-hidden bg-canvas-pure border border-quiet-gray/30 relative shadow-sm">
            <img
              src="/images/arpillera-testimony.webp"
              width="1200"
              height="1600"
              alt="Hand-stitched arpillera textile artwork by Barbara Schreiner"
              fetchpriority="high"
              decoding="async"
              class="w-full h-full object-cover object-center hover-img-zoom group-hover:scale-[1.03] transition-transform duration-700 filter contrast-[1.02]"
            />
            <!-- Archival Museum Placard (Bottom Overlay) -->
            <div class="absolute bottom-0 inset-x-0 bg-ink/95 backdrop-blur-sm p-4 sm:p-5 text-white border-t border-white/10">
              <div class="flex items-center justify-between gap-2 mb-1.5">
                <span class="text-[10px] font-semibold uppercase tracking-widest text-white/70 font-mono">Archive Piece · Craftivism</span>
                <span class="text-[10px] font-mono text-white/50">Cloth & Needle</span>
              </div>
              <p class="font-serif text-sm sm:text-base text-white/95 italic">
                &ldquo;Cloth and thread as instruments of testimony, collective healing, and social justice.&rdquo;
              </p>
              <div class="mt-2 pt-2 border-t border-white/10 flex items-center justify-between text-[11px] text-white/80">
                <span>Barbara Schreiner · Cape Town</span>
                <a href="/services/craftivism-and-creative-practice" class="text-white hover:underline text-[10px] uppercase tracking-wider font-semibold">
                  View Practice &rarr;
                </a>
              </div>
            </div>
          </div>
          
          <!-- Subtle Decorative Accent Behind Art Frame (Editorial Refero corner marks) -->
          <div class="hidden sm:block absolute -top-2.5 -right-2.5 w-6 h-6 border-t-2 border-r-2 border-thread-red pointer-events-none"></div>
          <div class="hidden sm:block absolute -bottom-2.5 -left-2.5 w-6 h-6 border-b-2 border-l-2 border-terracotta pointer-events-none"></div>
        </div>
      </div>

    </div>

    <!-- 2. Concrete Credentials Row (High Contrast Architectural Grid) -->
    <div class="reveal delay-400 mt-14 sm:mt-18 pt-8 border-t border-quiet-gray/25 grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      <div class="p-4 sm:p-5 bg-canvas-pure border border-quiet-gray/20">
        <span class="block text-3xl sm:text-4xl font-display text-ink font-semibold">30+</span>
        <span class="text-[11px] sm:text-xs uppercase tracking-wider text-ink-muted font-medium mt-1 block">Years in Policy & Governance</span>
        <span class="text-[11px] text-ink-muted/80 mt-1 block font-light">Advising across Africa and international water agencies.</span>
      </div>
      <div class="p-4 sm:p-5 bg-canvas-pure border border-quiet-gray/20">
        <span class="block text-3xl sm:text-4xl font-display text-ink font-semibold">DWAF & WIN</span>
        <span class="text-[11px] sm:text-xs uppercase tracking-wider text-ink-muted font-medium mt-1 block">Senior Leadership</span>
        <span class="text-[11px] text-ink-muted/80 mt-1 block font-light">Former Deputy Director General & WIN Executive Director.</span>
      </div>
      <div class="p-4 sm:p-5 bg-canvas-pure border border-quiet-gray/20">
        <span class="block text-3xl sm:text-4xl font-display text-ink font-semibold">6 Books</span>
        <span class="text-[11px] sm:text-xs uppercase tracking-wider text-ink-muted font-medium mt-1 block">Published Works</span>
        <span class="text-[11px] text-ink-muted/80 mt-1 block font-light">Novels, biography, poetry & women’s prison writings.</span>
      </div>
      <div class="p-4 sm:p-5 bg-canvas-pure border border-quiet-gray/20">
        <span class="block text-3xl sm:text-4xl font-display text-thread-red font-semibold">Arpilleras</span>
        <span class="text-[11px] sm:text-xs uppercase tracking-wider text-ink-muted font-medium mt-1 block">Textile Craftivism</span>
        <span class="text-[11px] text-ink-muted/80 mt-1 block font-light">Turning silenced histories into tangible evidence.</span>
      </div>
    </div>
  </section>

  <!-- 3. Curated Visual Showcase: "The Tapestry of Testimony" -->
  <section class="py-16 sm:py-24 bg-paper-gray/50 border-y border-quiet-gray/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="reveal flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-semibold uppercase tracking-widest text-terracotta">Visual Archive & Craftivism</span>
          <h2 class="text-3xl sm:text-5xl font-display-light text-ink mt-2">
            The tapestry of <span class="font-display-italic text-thread-red">testimony</span>.
          </h2>
        </div>
        <p class="text-sm text-ink-muted max-w-md font-light">
          Cloth, thread, and lived experience: how Barbara Schreiner brings marginalized narratives from hidden corners into public dialogue.
        </p>
      </div>

      <!-- Masterpiece Hero Crop + Process Diptych -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        <!-- Large Masterpiece: Women of Gaza (7 cols) -->
        <div class="reveal lg:col-span-7 flex flex-col">
          <div class="group relative w-full aspect-[16/10] overflow-hidden bg-canvas-pure border border-quiet-gray/25 flex-1">
            <img
              src="/images/women-of-gaza.webp"
              width="1600"
              height="1094"
              alt="Women of Gaza textile arpillera art piece by Barbara Schreiner"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover object-center filter saturate-[0.98] hover-img-zoom group-hover:scale-[1.03] transition-transform duration-700"
            />
            <div class="absolute bottom-3 left-3 right-3 sm:left-5 sm:bottom-5 bg-canvas/95 backdrop-blur-xs py-2.5 px-4 max-w-md border border-quiet-gray/20 text-xs text-ink">
              <span class="font-semibold text-thread-red uppercase tracking-wider block text-[10px]">Featured Masterpiece</span>
              <span class="italic font-serif text-sm">&ldquo;Women of Gaza&rdquo;</span> &mdash; Hand-stitched arpillera in the tradition of cloth, needle, and testimony by Barbara Schreiner.
            </div>
          </div>
        </div>

        <!-- Diptych of Practice: Workshop & Texture (5 cols) -->
        <div class="reveal delay-100 lg:col-span-5 flex flex-col gap-6 justify-between">
          <div class="group relative aspect-[16/9] w-full overflow-hidden bg-canvas-pure border border-quiet-gray/25">
            <img
              src="/images/craftivism-workshop-1.webp"
              width="1200"
              height="1600"
              alt="Participants stitching together in a craftivism workshop"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover hover-img-zoom group-hover:scale-[1.03] transition-transform duration-700"
            />
            <div class="absolute bottom-2 left-2 bg-canvas/90 backdrop-blur-xs px-3 py-1 border border-quiet-gray/20 text-[10px] text-ink uppercase tracking-wider font-semibold">
              Hands at Work: Collective Storytelling
            </div>
          </div>

          <div class="group relative aspect-[16/9] w-full overflow-hidden bg-canvas-pure border border-quiet-gray/25">
            <img
              src="/images/textile-art-1.webp"
              width="1200"
              height="1600"
              alt="Textile artwork detail from Barbara Schreiner's arpillera practice"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover hover-img-zoom group-hover:scale-[1.03] transition-transform duration-700"
            />
            <div class="absolute bottom-2 left-2 bg-canvas/90 backdrop-blur-xs px-3 py-1 border border-quiet-gray/20 text-[10px] text-ink uppercase tracking-wider font-semibold">
              Textile Detail: Cloth as Testimony
            </div>
          </div>

          <!-- Editorial Pull-Quote Block -->
          <div class="p-5 bg-canvas-pure border-l-2 border-thread-red border-y border-r border-quiet-gray/20">
            <p class="font-serif text-base text-ink italic leading-relaxed">
              &ldquo;Objects become arguments and evidence, inviting viewers to confront what official narratives leave unaddressed.&rdquo;
            </p>
            <span class="block mt-2 text-xs font-semibold text-terracotta uppercase tracking-wider">&mdash; Barbara Schreiner</span>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 4. Narrative Section: Creating Change -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="reveal lg:col-span-5 space-y-4">
        <span class="text-xs font-semibold uppercase tracking-widest text-terracotta">Our Foundation</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display-light text-ink leading-tight">
          Creating change, <br /><span class="font-display-italic text-thread-crimson">one thread</span> at a time.
        </h2>
        <p class="text-sm text-ink-muted font-serif italic leading-relaxed pt-2">
          &ldquo;Change is stitched together one thread, one story, one voice at a time, whether through groups working together or individuals pursuing personal development.&rdquo;
        </p>

        <!-- Real-life field photo anchor -->
        <figure class="group relative aspect-[16/11] w-full overflow-hidden bg-paper-gray border border-quiet-gray/25">
          <img
            src="/images/fieldwork-1.webp"
            width="1600"
            height="1200"
            alt="Red Thread work in the field"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover hover-img-zoom group-hover:scale-[1.03] transition-transform duration-700"
          />
          <figcaption class="absolute bottom-0 inset-x-0 bg-ink/90 backdrop-blur-sm px-4 py-2.5 text-white text-[10px] uppercase tracking-wider font-semibold flex items-center justify-between">
            <span>From the Field · Red Thread</span>
            <span class="font-mono text-white/60">Practice in the World</span>
          </figcaption>
        </figure>
      </div>

      <div class="reveal delay-200 lg:col-span-7 space-y-6 text-base text-ink-muted leading-relaxed font-light">
        <p>
          Red Thread works at the intersection of craft, art, writing, and social change. We use creative methods &mdash; rooted in South African storytelling and Chilean craftivism traditions &mdash; to amplify the voices of those too often left unheard, and to open new ways of confronting the challenges of an unequal society.
        </p>
        <p>
          Alongside this, we offer consulting for change &mdash; particularly in the water sector &mdash; and build capacity for transformational leadership through coaching and mentoring. Our work spans social and environmental justice, including water integrity, using people-centred, creative processes that bring communities together, surface lived experience, and turn testimony into change.
        </p>
        <div class="p-6 bg-paper-gray/40 border-l-2 border-thread-red border-y border-r border-quiet-gray/20">
          <p class="text-sm text-ink font-medium">
            &ldquo;Feel free to contact me to set up an exploratory conversation to discuss your context and needs.&rdquo;
          </p>
          <div class="mt-3 flex items-center justify-between">
            <span class="text-xs font-semibold text-terracotta uppercase tracking-wider">&mdash; Barbara Schreiner</span>
            <a href="/contact#consultation" class="text-xs font-semibold text-thread-red hover:underline uppercase tracking-wider">
              Start a Conversation &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. The Three Core Practices (Elevated Editorial Cards with Clear Outcomes) -->
  <section class="py-24 bg-canvas-pure border-t border-quiet-gray/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="reveal flex flex-col md:flex-row md:items-end justify-between mb-16 gap-4">
        <div>
          <span class="text-xs font-semibold uppercase tracking-widest text-terracotta">What We Do</span>
          <h2 class="text-4xl sm:text-5xl font-display-light text-ink mt-2">
            Three pillars of <span class="font-display-italic text-thread-red">practice</span>.
          </h2>
        </div>
        <a href="/services" class="editorial-btn px-6 py-2.5 bg-canvas border border-quiet-gray/30 hover:bg-paper-gray text-xs uppercase tracking-widest font-semibold text-ink transition-colors">
          Detailed Practice Overview &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
        
        <!-- Pillar 1: Creativity & Craftivism -->
        <div class="reveal flex flex-col group bg-canvas border border-quiet-gray/20 p-6 sm:p-7">
          <div class="aspect-[16/10] w-full overflow-hidden bg-canvas-pure border border-quiet-gray/20 mb-6">
            <img
              src="/images/craftivism-workshop-3.webp"
              width="1600"
              height="1200"
              alt="Craftivism and textile workshop participants"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover hover-img-zoom group-hover:scale-[1.03] transition-transform duration-700"
            />
          </div>
          
          <div class="flex items-center justify-between mb-2">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-terracotta">01 / Creative Practice</span>
            <span class="text-[10px] font-mono text-ink-muted/70">Art & Healing</span>
          </div>

          <h3 class="text-2xl font-serif font-medium text-ink mb-3 group-hover:text-thread-red transition-colors">
            Creativity for Change
          </h3>
          
          <p class="text-sm text-ink-muted leading-relaxed font-light mb-6 flex-1">
            Rooted in Chilean arpillera traditions and South African storytelling. We use cloth, thread, and creative writing as instruments of testimony, collective healing, and social justice.
          </p>

          <div class="space-y-2 mb-6 pt-4 border-t border-quiet-gray/15 text-xs text-ink-muted">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-thread-red"></span>
              <span>Community craftivism workshops</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-thread-red"></span>
              <span>Trauma processing through textile art</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-thread-red"></span>
              <span>Public exhibitions and dialogue</span>
            </div>
          </div>

          <a href="/services/craftivism-and-creative-practice" class="text-xs uppercase tracking-wider font-semibold text-thread-red hover:text-thread-crimson inline-flex items-center gap-1">
            <span>Learn about Craftivism</span>
            <span>&rarr;</span>
          </a>
        </div>

        <!-- Pillar 2: Coaching for Change -->
        <div class="reveal delay-100 flex flex-col group bg-canvas border border-quiet-gray/20 p-6 sm:p-7">
          <div class="aspect-[16/10] w-full overflow-hidden bg-canvas-pure border border-quiet-gray/20 mb-6">
            <img
              src="/images/individual-coaching.webp"
              width="1600"
              height="1066"
              alt="One-on-one transformational leadership coaching session"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover hover-img-zoom group-hover:scale-[1.03] transition-transform duration-700"
            />
          </div>

          <div class="flex items-center justify-between mb-2">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-terracotta">02 / Leadership & Renewal</span>
            <span class="text-[10px] font-mono text-ink-muted/70">Personal & Executive</span>
          </div>

          <h3 class="text-2xl font-serif font-medium text-ink mb-3 group-hover:text-thread-red transition-colors">
            Coaching for Change
          </h3>

          <p class="text-sm text-ink-muted leading-relaxed font-light mb-6 flex-1">
            For leaders and professionals navigating burnout, career redirection, or habits holding them back; and for teams undergoing organizational restructuring. Offered in person or online.
          </p>

          <div class="space-y-2 mb-6 pt-4 border-t border-quiet-gray/15 text-xs text-ink-muted">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-thread-red"></span>
              <span>Individual transformational coaching</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-thread-red"></span>
              <span>Burnout recovery & resilience strategies</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-thread-red"></span>
              <span>Organizational transition & team alignment</span>
            </div>
          </div>

          <a href="/services/coaching-for-change" class="text-xs uppercase tracking-wider font-semibold text-thread-red hover:text-thread-crimson inline-flex items-center gap-1">
            <span>Explore Coaching Options</span>
            <span>&rarr;</span>
          </a>
        </div>

        <!-- Pillar 3: Water Governance Consulting -->
        <div class="reveal delay-200 flex flex-col group bg-canvas border border-quiet-gray/20 p-6 sm:p-7">
          <div class="aspect-[16/10] w-full overflow-hidden bg-canvas-pure border border-quiet-gray/20 mb-6">
            <img
              src="/images/water-governance.webp"
              width="1600"
              height="1067"
              alt="Water governance and policy advisory"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover hover-img-zoom group-hover:scale-[1.03] transition-transform duration-700"
            />
          </div>

          <div class="flex items-center justify-between mb-2">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-terracotta">03 / Policy & Integrity</span>
            <span class="text-[10px] font-mono text-ink-muted/70">Institutional Advisory</span>
          </div>

          <h3 class="text-2xl font-serif font-medium text-ink mb-3 group-hover:text-thread-red transition-colors">
            Consulting for Change
          </h3>

          <p class="text-sm text-ink-muted leading-relaxed font-light mb-6 flex-1">
            Thirty years inside environmental policy and public leadership. We advise governments, NGOs, and utilities on institutional integrity, water tenure, anti-corruption, and equity frameworks.
          </p>

          <div class="space-y-2 mb-6 pt-4 border-t border-quiet-gray/15 text-xs text-ink-muted">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-thread-red"></span>
              <span>Water tenure & resource governance</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-thread-red"></span>
              <span>Anti-corruption & integrity systems</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-thread-red"></span>
              <span>Institutional restructuring & policy reform</span>
            </div>
          </div>

          <a href="/services/water-governance-consulting" class="text-xs uppercase tracking-wider font-semibold text-thread-red hover:text-thread-crimson inline-flex items-center gap-1">
            <span>Consulting Advisory</span>
            <span>&rarr;</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- 6. Voices of Testimony & Transformation (Editorial Quotes Grid) -->
  <section class="py-20 bg-paper-gray/40 border-y border-quiet-gray/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="reveal text-center max-w-2xl mx-auto mb-14 space-y-3">
        <span class="text-xs font-semibold uppercase tracking-widest text-terracotta">Voices of Experience</span>
        <h2 class="text-3xl sm:text-4xl font-display-light text-ink">
          Testimony that leads to <span class="font-display-italic text-thread-red">change</span>.
        </h2>
        <p class="text-sm text-ink-muted font-light">
          Reflections from the circles, coaching rooms, and policy roundtables where Red Thread engages.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Quote 1: Craftivism -->
        <div class="reveal p-7 bg-canvas-pure border border-quiet-gray/20 flex flex-col justify-between">
          <div class="space-y-4">
            <span class="text-3xl font-display text-thread-red font-light select-none">&ldquo;</span>
            <p class="font-serif text-sm sm:text-base text-ink italic leading-relaxed -mt-4">
              The craftivism workshop created a sacred space where our unspoken traumas found physical form through fabric and stitch. It gave our community a voice that words alone could never reach.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-quiet-gray/15">
            <span class="block text-xs font-semibold text-ink uppercase tracking-wider">Community Workshop Participant</span>
            <span class="text-[11px] text-ink-muted font-light">Cape Town Craftivism Collective</span>
          </div>
        </div>

        <!-- Quote 2: Coaching -->
